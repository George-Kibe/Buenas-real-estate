# Copy to .env and fill in. Never commit .env.

# --- Django core ---
SECRET_KEY=change-me
SIGNING_KEY=change-me-too
DEBUG=True
# Comma-separated (django-environ list parsing)
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=real_estate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_HOST=postgres-db
PG_PORT=5432

# --- Email (feeds the MAILERS setting) ---
# Development defaults to the console backend; set a real one to send mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@buenasconsultants.co.ke
DOMAIN=localhost:3000

# --- Celery ---
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0
# Set True to run tasks inline without a worker (handy for tests)
CELERY_TASK_ALWAYS_EAGER=False
