#!/bin/bash

set -o errexit
set -o nounset

worker_ready() {
  celery -A real_estate inspect ping
}

until worker_ready; do
  >&2 echo 'Celery workers not available :-('
  sleep 1
done
>&2 echo 'Celery workers are available and ready!...:-)'

exec celery -A real_estate flower \
  --broker="${CELERY_BROKER}" \
  --port=5555
