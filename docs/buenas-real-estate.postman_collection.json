  "item": [
    {
      "name": "Auth",
      "_postman_id": "6012aaf1-9bc7-551a-bdfc-01549ed62fbe",
      "description": "Registration, JWT and account management (djoser).",
      "item": [
        {
          "name": "Register",
          "_postman_id": "80be036d-90ca-59f1-ba3a-6c8afc0c263c",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/users/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "users",
                ""
              ]
            },
            "description": "Creates an **inactive** account and emails an activation link (DJOSER.SEND_ACTIVATION_EMAIL is on), so this account cannot log in until it is activated. It uses a throwaway random identity so it never collides with the seeded login account below.\n\nFor a signed-in session, run `make seed-demo` and use *Login* with the credentials it prints.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{$randomUserName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"first_name\": \"{{$randomFirstName}}\",\n  \"last_name\": \"{{$randomLastName}}\",\n  \"password\": \"{{password}}\",\n  \"re_password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"registration returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (obtain JWT pair)",
          "_postman_id": "d1e3cb8a-5085-59cb-b954-158ddfd93f90",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/jwt/create/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "jwt",
                "create",
                ""
              ]
            },
            "description": "The login field is the email address, not the username. The account must be active \u2014 run `make seed-demo` to get one.\n\nStores `accessToken` and `refreshToken`; every other request inherits bearer auth from the collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.access);",
                  "if (pm.environment.name) { pm.environment.set(\"accessToken\", body.access); }",
                  "pm.collectionVariables.set(\"refreshToken\", body.refresh);",
                  "if (pm.environment.name) { pm.environment.set(\"refreshToken\", body.refresh); }",
                  "",
                  "pm.test(\"token pair is present\", function () {",
                  "    pm.expect(body).to.have.property('access');",
                  "    pm.expect(body).to.have.property('refresh');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "_postman_id": "1c524cd9-2aa3-54c9-a7fe-47b997ad09a6",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/jwt/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "jwt",
                "refresh",
                ""
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refresh returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const access = pm.response.json().access;",
                  "pm.collectionVariables.set(\"accessToken\", access);",
                  "if (pm.environment.name) { pm.environment.set(\"accessToken\", access); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify access token",
          "_postman_id": "5d963ec9-7cc0-56d8-af0d-e8916717311d",
          "request": {
            "method": "POST",
            "header": [
              {
