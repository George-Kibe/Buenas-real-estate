        {
          "name": "Create a property",
          "_postman_id": "90ff4bdb-303c-5770-a1f9-2133cd2af004",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/create/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "create",
                ""
              ]
            },
            "description": "The owner comes from the access token. `user`, `slug`, `ref_code` and `views` in the body are ignored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lakeside villa in Naivasha\",\n  \"description\": \"A calm three bedroom home looking over Lake Naivasha.\",\n  \"country\": \"KE\",\n  \"city\": \"Naivasha\",\n  \"postal_code\": \"20117\",\n  \"street_address\": \"Moi South Lake Road\",\n  \"property_number\": 42,\n  \"price\": \"12500000.00\",\n  \"tax\": \"0.15\",\n  \"plot_area\": \"450.00\",\n  \"total_floors\": 2,\n  \"bedrooms\": 3,\n  \"bathrooms\": \"2.50\",\n  \"advert_type\": \"For Sale\",\n  \"property_type\": \"House\",\n  \"published_status\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"creation returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const created = pm.response.json();",
                  "pm.collectionVariables.set(\"propertySlug\", created.slug);",
                  "if (pm.environment.name) { pm.environment.set(\"propertySlug\", created.slug); }",
                  "",
                  "pm.test(\"server owns slug and ref_code\", function () {",
                  "    pm.expect(created.slug).to.be.a('string').and.not.empty;",
                  "    pm.expect(created.ref_code).to.have.lengthOf(10);",
                  "    pm.expect(created.views).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Property detail",
          "_postman_id": "7b9381ee-0902-5a9b-a002-33068226b004",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/details/{{propertySlug}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
