# Next.js 16 requires Node >= 20.9; 24 is the active LTS line.
ARG NODE_VERSION=24-alpine

FROM node:${NODE_VERSION}

LABEL version="2.0"
LABEL description="Next.js frontend for the Buenas Real Estate API"

WORKDIR /app

COPY ./package*.json ./
RUN npm install

COPY . /app

EXPOSE 3000
CMD ["npm", "run", "dev"]
